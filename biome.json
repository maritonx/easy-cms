{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.turbo",
      "!**/node_modules",
      "!**/.nuxt",
      "!**/.output",
      "!**/.next",
      "!**/.pglite*",
      "!**/next-env.d.ts",
      "!**/.tmp",
      "!**/test-results",
      "!**/__snapshots__",
      "!**/easy-cms/migrations",
      "!**/.registry",
      "!**/.vitepress/cache"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useVueMultiWordComponentNames": "off",
            "useImportType": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**", "!packages/core/src/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Core runs on more than Node (ADR-0067): import from src/runtime/ instead."
                  }
                ]
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Core runs on more than Node (ADR-0067): use src/runtime/bytes.ts instead."
                }
              }
            }
          }
        }
      }
    }
  ],
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  }
}
