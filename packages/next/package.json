{
  "name": "@easy-cms/next",
  "version": "0.49.0",
  "description": "Next.js adapter for Easy CMS",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./live-preview": {
      "types": "./dist/live-preview.d.ts",
      "default": "./dist/live-preview.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "@easy-cms/admin": "workspace:^"
  },
  "peerDependencies": {
    "@easy-cms/core": "workspace:^",
    "next": ">=15.0.0",
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "@easy-cms/core": "workspace:^",
    "@easy-cms/db-sqlite": "workspace:^",
    "@types/react": "^19.2.0",
    "next": "^16.3.8",
    "react": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-cms.git",
    "directory": "packages/next"
  },
  "keywords": [
    "easy-cms",
    "nextjs",
    "next",
    "cms",
    "headless-cms"
  ]
}
