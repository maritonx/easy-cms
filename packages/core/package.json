{
  "name": "@easy-cms/core",
  "version": "1.57.2",
  "description": "The code-first CMS and app backend for Nuxt and Next.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "easy-cms-browser": "./dist/browser/index.js",
      "default": "./dist/index.js"
    },
    "./live-preview": {
      "types": "./dist/live-preview.d.ts",
      "easy-cms-browser": "./dist/browser/live-preview.js",
      "default": "./dist/live-preview.js"
    },
    "./conditions": {
      "types": "./dist/conditions.d.ts",
      "easy-cms-browser": "./dist/browser/conditions.js",
      "default": "./dist/conditions.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "easy-cms-browser": "./dist/browser/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "easy-cms-browser": "./dist/browser/client.js",
      "default": "./dist/client.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "easy-cms-browser": "./dist/browser/internal.js",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-publish.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "jiti": "^2.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-cms.git",
    "directory": "packages/core"
  },
  "keywords": [
    "cms",
    "headless-cms",
    "nuxt",
    "nextjs",
    "vue",
    "react"
  ],
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0 <2",
    "sharp": ">=0.33.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "~1.10.0",
    "sharp": "^0.35.5"
  }
}
