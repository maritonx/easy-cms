{
  "name": "@easy-cms/plugin-notify",
  "version": "1.46.1",
  "description": "Notifications for Easy CMS admins: Telegram messages when a form is submitted, an order comes in or something fails",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../../scripts/check-publish.mjs"
  },
  "peerDependencies": {
    "@easy-cms/core": "workspace:^"
  },
  "devDependencies": {
    "@easy-cms/core": "workspace:^",
    "@easy-cms/db-sqlite": "workspace:^",
    "simple-icons": "16.36.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-cms.git",
    "directory": "packages/plugin-notify"
  },
  "keywords": [
    "easy-cms",
    "easy-cms-plugin",
    "notifications",
    "telegram"
  ]
}
