{
  "name": "@easy-cms/plugin-seo",
  "version": "0.38.0",
  "description": "SEO for Easy CMS: meta fields, length meters, a search result preview, generators and page metadata",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": "./dist/admin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@easy-cms/richtext": "workspace:^"
  },
  "peerDependencies": {
    "@easy-cms/core": "workspace:^"
  },
  "devDependencies": {
    "@easy-cms/core": "workspace:^",
    "@easy-cms/db-sqlite": "workspace:^",
    "happy-dom": "^20.14.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maritonx/easy-cms.git",
    "directory": "packages/plugin-seo"
  },
  "keywords": [
    "easy-cms",
    "easy-cms-plugin",
    "seo",
    "meta",
    "open-graph"
  ]
}
