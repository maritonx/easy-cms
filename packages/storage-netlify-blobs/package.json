{
  "name": "@easy-cms/storage-netlify-blobs",
  "version": "0.37.0",
  "description": "Netlify Blobs upload storage for Easy CMS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
